{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/daftar",
      "destination": "/daftar.html"
    },
    {
      "source": "/profil",
      "destination": "/profil.html"
    },
    {
      "source": "/guru",
      "destination": "/guru.html"
    },
    {
      "source": "/fasilitas",
      "destination": "/fasilitas.html"
    },
    {
      "source": "/program",
      "destination": "/program.html"
    },
    {
      "source": "/spmb",
      "destination": "/spmb.html"
    },
    {
      "source": "/pengumuman",
      "destination": "/pengumuman.html"
    },
    {
      "source": "/kontak",
      "destination": "/kontak.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, private"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
